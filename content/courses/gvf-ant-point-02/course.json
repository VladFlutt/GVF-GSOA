        {
          "kind": "theory",
          "id": "interference",
          "title": {
            "ru": "Почему важны помехи",
            "en": "Why interference matters",
            "el": "Γιατί οι παρεμβολές είναι κρίσιμες"
          },
          "body": [
            {
