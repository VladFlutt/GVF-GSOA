    {
      "id": "geometry",
      "title": {
        "ru": "Геометрия и поляризация",
        "en": "Geometry and polarisation",
        "el": "Γεωμετρία και πόλωση"
      },
      "objectives": [
        {
          "ru": "Использовать широту, азимут и угол места как исходные данные",
          "en": "Use latitude, azimuth and elevation as initial data",
          "el": "Χρησιμοποιείτε γεωγραφικό πλάτος, αζιμούθιο και ανύψωση"
        },
        {
          "ru": "Выбирать линейную или круговую поляризацию и рассчитывать поворот облучателя",
          "en": "Select polarisation and calculate feed rotation",
          "el": "Επιλέγετε πόλωση και υπολογίζετε την περιστροφή τροφοδότη"
        }
      ],
      "steps": [
        {
          "kind": "theory",
          "id": "lat-lon",
          "title": {
            "ru": "Исходная геометрия",
            "en": "Initial geometry",
            "el": "Αρχική γεωμετρία"
          },
          "body": [
            {
              "ru": "Широта и долгота станции влияют на азимут и угол места геостационарного спутника. Расчёт даёт стартовую точку, но не заменяет поиск максимума сигнала и проверку фактического направления.",
              "en": "Station latitude and longitude determine the initial azimuth and elevation to a geostationary satellite. The calculation is a starting point, not a substitute for peaking and an azimuth check.",
              "el": "Το γεωγραφικό πλάτος και μήκος δίνουν την αρχική κατεύθυνση προς γεωστατικό δορυφόρο, αλλά δεν αντικαθιστούν τη βελτιστοποίηση σήματος."
            }
          ],
