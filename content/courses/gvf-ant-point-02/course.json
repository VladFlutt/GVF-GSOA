{
  "id": "gvf-ant-point-02",
  "code": "GVF-ANT-POINT-02",
  "title": {
    "ru": "Наведение и проверка морской VSAT-антенны",
    "en": "Marine VSAT Antenna Pointing and Verification",
    "el": "Σκόπευση και επαλήθευση ναυτιλιακής κεραίας VSAT"
  },
  "summary": {
    "ru": "Практический курс по подготовке кабелей, расчёту геометрии, поиску спутника, точной наводке beam balance и проверке cross-pol.",
    "en": "A practical course on cable preparation, pointing geometry, satellite acquisition, beam-balance peaking and cross-pol verification.",
    "el": "Πρακτικό μάθημα για καλώδια, γεωμετρία σκόπευσης, εύρεση δορυφόρου, beam balance και επαλήθευση cross-pol."
  },
  "prerequisites": [
    {
      "ru": "GVF562N «Эксплуатация терминала Intellian v100 и аналогичных»",
      "en": "GVF562N Operating the Intellian v100 and similar terminals",
      "el": "GVF562N Λειτουργία του Intellian v100 και παρόμοιων τερματικών"
    }
  ],
  "modules": [
    {
      "id": "hardware",
      "title": {
        "ru": "Оборудование и подготовка",
        "en": "Hardware and preparation",
        "el": "Εξοπλισμός και προετοιμασία"
      },
      "objectives": [
        {
          "ru": "Распознавать элементы RF-тракта и типовые дефекты разъёмов",
          "en": "Recognise RF-path parts and common connector defects",
          "el": "Αναγνωρίζετε τα μέρη RF και τα ελαττώματα συνδέσεων"
        },
        {
          "ru": "Подготавливать и герметизировать кабель перед включением",
          "en": "Prepare and weatherproof a cable before powering up",
          "el": "Προετοιμάζετε και στεγανοποιείτε καλώδιο πριν την ενεργοποίηση"
        }
      ],
      "steps": [
        {
          "kind": "theory",
          "id": "station-hardware",
          "title": {
            "ru": "Оборудование сетевой VSAT-станции",
            "en": "Networked VSAT earth-station hardware",
            "el": "Εξοπλισμός σταθμού VSAT"
          },
          "body": [
            {
              "ru": "Проверьте наружный блок, антенну, облучатель, передающий и приёмный тракт, кабельные вводы и точку подключения к оборудованию. Соединения должны быть закреплены, промаркированы и защищены от влаги.",
              "en": "Check the outdoor unit, antenna, feed, transmit and receive paths, cable entries and equipment connection. Connections must be secured, labelled and protected from moisture.",
              "el": "Ελέγξτε την εξωτερική μονάδα, την κεραία, τον τροφοδότη, τις διαδρομές εκπομπής και λήψης και τις εισόδους καλωδίων. Οι συνδέσεις πρέπει να είναι ασφαλισμένες και στεγανές."
            }
          ],
